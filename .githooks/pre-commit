#!/usr/bin/env bash
set -euo pipefail

# Block staging model weight artifacts, fused directories, or private datasets.
staged_files="$(git diff --cached --name-only)"

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked_pattern='(\.safetensors|\.bin|\.gguf|\.npz|\.pt|\.pth$|^models/|^adapters/|^cevin-.*-4bit-fused/|^Qwen2\.5-|^training_data/|^data/private/)'

while IFS= read -r file; do
  if printf '%s\n' "$file" | grep -Eq "$blocked_pattern"; then
    echo "ERROR: Refusing to commit model weight or private data file: $file" >&2
    exit 1
  fi
  if printf '%s\n' "$file" | grep -Eq '\.jsonl$' && ! printf '%s\n' "$file" | grep -Eq '^data/sample/'; then
    echo "ERROR: Refusing to commit JSONL file outside data/sample/: $file" >&2
    exit 1
  fi
done <<< "$staged_files"
